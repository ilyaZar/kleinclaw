{
  "name": "@ilyazar/miniclaw",
  "version": "0.3.0",
  "description": "TypeScript CLI package for local Kleinanzeigen listing workflows",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyaZar/miniclaw.git"
  },
  "bugs": {
    "url": "https://github.com/ilyaZar/miniclaw/issues"
  },
  "homepage": "https://github.com/ilyaZar/miniclaw#readme",
  "keywords": [
    "kleinanzeigen",
    "cli",
    "browser-automation",
    "typescript"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "npm run build && npm test"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "bin": {
    "miniclaw": "./dist/cli.js"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "glob": "^13.0.6",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3"
  }
}
