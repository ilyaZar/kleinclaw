{
  "name": "kleinclaw",
  "version": "0.2.2",
  "description": "Kleinanzeigen tools that can change live listings and run miniclaw with redacted output",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyaZar/kleinclaw.git"
  },
  "bugs": {
    "url": "https://github.com/ilyaZar/kleinclaw/issues"
  },
  "homepage": "https://github.com/ilyaZar/kleinclaw#readme",
  "keywords": [
    "openclaw",
    "plugin",
    "kleinclaw",
    "kleinanzeigen"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "CHANGELOG.md",
    "examples/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "dist/",
    "index.js",
    "miniclaw/",
    "openclaw.plugin.json",
    "skills/kleinanzeigen-helper-skill/"
  ],
  "scripts": {
    "build": "npm run clean:generated && npm run build:miniclaw && npm run build:host",
    "build:host": "tsc -p tsconfig.host.json",
    "build:miniclaw": "tsc -p tsconfig.miniclaw.json",
    "clean:generated": "node scripts/clean-generated.mjs",
    "coverage": "npm run build && npm run coverage:built",
    "coverage:built": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "generated:check": "test -z \"$(git status --short --untracked-files=all -- dist miniclaw/dist)\"",
    "package:check": "npm run build && npm run package:check:built",
    "package:check:built": "node --test test/package/*.test.js",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test",
    "verify": "npm run build && npm run generated:check && npm run test:built"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "glob": "^13.0.6",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "install": {
      "minHostVersion": ">=2026.6.5"
    },
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.3-beta.3",
      "minGatewayVersion": "2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.11.10",
      "pluginSdkVersion": "2026.11.10"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3"
  }
}
